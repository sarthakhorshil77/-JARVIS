
function processCommand(command) {
 const cmd = command.toLowerCase().trim();

 addMessage("BOSS", command);

 let answer = "";

 if (
   cmd.includes("hello") ||
   cmd.includes("hi") ||
   cmd.includes("नमस्ते")
 ) {
   answer = "Hello Boss! कैसे हैं आप?";
 }

 else if (
   cmd.includes("bolo") ||
   cmd.includes("बोलो") ||
   cmd.includes("sun rahe") ||
   cmd.includes("सुन रहे")
 ) {
   answer = "जी Boss! मैं सुन रहा हूँ। बताइए, क्या करना है?";
 }

 else if (
   cmd === "kay" ||
   cmd.includes("kya") ||
   cmd.includes("क्या")
 ) {
   answer = "Boss, मैं आपकी हर बात सुनने के लिए तैयार हूँ।";
 }

 else if (
   cmd.includes("kaise ho") ||
   cmd.includes("कैसे हो")
 ) {
   answer = "मैं बिल्कुल ठीक हूँ Boss! आप कैसे हैं?";
 }

 else if (
   cmd.includes("naam") ||
   cmd.includes("name")
 ) {
   answer = "मेरा नाम JARVIS है। मैं आपका Personal AI Assistant हूँ।";
 }

 else if (
   cmd.includes("tum kya kar sakte") ||
   cmd.includes("क्या कर सकते")
 ) {
   answer = "Boss, मैं वेबसाइट खोल सकता हूँ, समय बता सकता हूँ और आपके सवालों के जवाब दे सकता हूँ।";
 }

 else if (
   cmd.includes("youtube") ||
   cmd.includes("यूट्यूब")
 ) {
   openSite("YouTube", "https://youtube.com");
   return;
 }

 else if (
   cmd.includes("whatsapp") ||
   cmd.includes("व्हाट्सएप")
 ) {
   openSite("WhatsApp", "https://web.whatsapp.com");
   return;
 }

 else if (
   cmd.includes("google") ||
   cmd.includes("गूगल")
 ) {
   openSite("Google", "https://google.com");
   return;
 }

 else if (
   cmd.includes("time") ||
   cmd.includes("समय")
 ) {
   answer = "Boss, अभी समय है " +
   new Date().toLocaleTimeString("hi-IN");
 }

 else if (
   cmd.includes("date") ||
   cmd.includes("तारीख")
 ) {
   answer = "आज की तारीख है " +
   new Date().toLocaleDateString("hi-IN");
 }

 else {
   answer = "जी Boss, मैंने आपकी बात सुनी। थोड़ा और बताइए, मैं आपकी मदद करने की कोशिश करता हूँ।";
 }

 reply(answer);
}
